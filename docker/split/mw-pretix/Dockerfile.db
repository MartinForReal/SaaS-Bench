# syntax=docker/dockerfile:1.7
# snapshot db image for mw-pretix (postgres datadir with pretix migrations applied)
ARG BASE_IMAGE=mw-pretix:latest
FROM ${BASE_IMAGE} AS snapshot
USER root
ENV PGDATA=/var/lib/postgresql/data
RUN set -eux;     mkdir -p "$PGDATA" /var/run/postgresql;     chown -R postgres:postgres "$PGDATA" /var/run/postgresql;     su postgres -s /bin/bash -c "initdb -D $PGDATA";     echo "host all all 127.0.0.1/32 trust" >> "$PGDATA/pg_hba.conf";     echo "listen_addresses = '127.0.0.1'" >> "$PGDATA/postgresql.conf";     su postgres -s /bin/bash -c "pg_ctl -D $PGDATA -l /tmp/pg.log -w start";     su postgres -s /bin/bash -c "psql -c "CREATE USER pretix WITH PASSWORD 'pretix' SUPERUSER;"";     su postgres -s /bin/bash -c "psql -c "CREATE DATABASE pretix OWNER pretix;"";     (cd /pretix/src && DJANGO_SETTINGS_MODULE=production_settings DATA_DIR=/data/ HOME=/pretix python3 -m pretix migrate --noinput) || true;     su postgres -s /bin/bash -c "pg_ctl -D $PGDATA -m fast -w stop";     rm -f "$PGDATA/postmaster.pid"

FROM scratch AS runtime
COPY --from=snapshot / /
ENTRYPOINT ["/opt/saas-bench/entrypoint-db.sh"]
