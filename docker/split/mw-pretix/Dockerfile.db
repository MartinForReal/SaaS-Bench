# syntax=docker/dockerfile:1.7
#
# Split image: ONE service per container (db).
#
# Base bundle : mw-pretix
# Entrypoint  : added by this image (entrypoint-db.sh)
#
# The app container still runs the fixture / migrations before serving; the db and
# redis containers only initialise their datadir (if empty) and then serve.

ARG BASE_IMAGE=mw-pretix:latest
FROM ${BASE_IMAGE}

USER root
COPY entrypoint-db.sh /opt/saas-bench/entrypoint-db.sh
RUN chmod +x /opt/saas-bench/entrypoint-db.sh
ENTRYPOINT ["/opt/saas-bench/entrypoint-db.sh"]
