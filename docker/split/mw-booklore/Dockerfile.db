# syntax=docker/dockerfile:1.7
# snapshot db image for mw-booklore (reuses the rebuild mysql-data datadir)
ARG BASE_IMAGE=mw-booklore:latest
FROM ${BASE_IMAGE} AS snapshot
USER root
RUN set -eux;     test -d /var/lib/mysql/mysql;     chown -R mysql:mysql /var/lib/mysql;     mkdir -p /run/mysqld; chown -R mysql:mysql /run/mysqld;     rm -f /var/lib/mysql/*.pid /var/lib/mysql/*.err /run/mysqld/*

FROM scratch AS runtime
COPY --from=snapshot / /
ENTRYPOINT ["/opt/saas-bench/entrypoint-db.sh"]
