# syntax=docker/dockerfile:1.7
#
# Split image: ONE service per container (redis).
#
# Base bundle : mw-hrms
# Entrypoint  : added by this image (entrypoint-redis.sh)
#
# The app container still runs the fixture / migrations before serving; the db and
# redis containers only initialise their datadir (if empty) and then serve.

ARG BASE_IMAGE=mw-hrms:latest
FROM ${BASE_IMAGE}

USER root
COPY entrypoint-redis.sh /opt/saas-bench/entrypoint-redis.sh
RUN chmod +x /opt/saas-bench/entrypoint-redis.sh
ENTRYPOINT ["/opt/saas-bench/entrypoint-redis.sh"]
