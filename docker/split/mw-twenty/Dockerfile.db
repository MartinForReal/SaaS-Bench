# syntax=docker/dockerfile:1.7
# snapshot db image for mw-twenty (postgres datadir with twenty setup+migrations applied)
ARG BASE_IMAGE=mw-twenty:latest
FROM ${BASE_IMAGE} AS snapshot
USER root
ENV PGDATA=/var/lib/postgresql/data
RUN set -eux;     mkdir -p "$PGDATA" /var/run/postgresql;     chown -R postgres:postgres "$PGDATA" /var/run/postgresql;     su-exec postgres initdb -D "$PGDATA";     echo "host all all 127.0.0.1/32 trust" >> "$PGDATA/pg_hba.conf";     echo "listen_addresses = '127.0.0.1'" >> "$PGDATA/postgresql.conf";     su-exec postgres pg_ctl -D "$PGDATA" -l /tmp/pg.log -w start;     su-exec postgres createdb default;     PG_DATABASE_URL="postgres://postgres:twenty_postgres_pass@127.0.0.1:5432/default"       DISABLE_CRON_JOBS_REGISTRATION=true /app/entrypoint.sh true;     su-exec postgres pg_ctl -D "$PGDATA" -m fast -w stop;     rm -f "$PGDATA/postmaster.pid"

FROM scratch AS runtime
COPY --from=snapshot / /
ENTRYPOINT ["/opt/saas-bench/entrypoint-db.sh"]
